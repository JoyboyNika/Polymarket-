# Notion API Configuration
# Get your integration token at https://www.notion.so/my-integrations
NOTION_TOKEN=ntn_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Parent page ID where the database will be created
# Extract from the Notion page URL: https://www.notion.so/Your-Page-{PAGE_ID}
# Remove hyphens from the URL ID
NOTION_PARENT_PAGE_ID=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Database ID (filled automatically after running create_database.py)
NOTION_DATABASE_ID=

# ── Ingestor (Bloc 1) ─────────────────────────────────────────
# Polling interval in seconds (default: 300 = 5 minutes)
POLL_INTERVAL_SECONDS=300

# Minimum trade size in USDC to fetch (default: 1000)
FILTER_AMOUNT_USDC=1000

# Deduplication window in hours (default: 24)
DEDUP_WINDOW_HOURS=24

# Polymarket API base URLs
API_BASE_URL=https://data-api.polymarket.com
GAMMA_API_URL=https://gamma-api.polymarket.com

# ── Scorer (Bloc 2) ───────────────────────────────────────────
# Pass thresholds
PASS1_THRESHOLD=5
PASS2_THRESHOLD=10

# Market/trade thresholds
TRADE_SIZE_RATIO_THRESHOLD=0.02
IMPROBABLE_PROBABILITY_THRESHOLD=0.10
MARKET_VOLUME_LOW_THRESHOLD=50000
TIMING_CLOSE_DAYS=7
WALLET_AGE_NEW_DAYS=7

# Category-based alert thresholds (Forensic Carmin Feb 2026)
# Standard markets (sport, politics, etc.): minimum USDC size to alert
ALERT_THRESHOLD_STANDARD=4000
# Crypto/indices markets (BTC, ETH, SOL, XRP, S&P 500, etc.): minimum USDC size
ALERT_THRESHOLD_CRYPTO=10000

# Funder aggregation window in hours (for split-trade detection)
AGGREGATION_WINDOW_HOURS=24

# Webhook (Make.com scenario URL)
MAKE_WEBHOOK_URL=

# Alchemy API key (free tier — for on-chain wallet profiling)
# Get yours at https://dashboard.alchemy.com
ALCHEMY_API_KEY=
